# Resend API — https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Audience ID (for contact list) — optional but recommended
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Sender address (must be a verified domain in Resend)
# During development you can use: onboarding@resend.dev (only sends to your Resend account email)
FROM_EMAIL=PICKUP <noreply@yourdomain.com>

# Your site URL (used in email links)
NEXT_PUBLIC_SITE_URL=https://pickup-community.vercel.app

# Admin email — receives notification on every new subscriber (optional)
ADMIN_EMAIL=deine@mail.de
